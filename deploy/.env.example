# Settings for one public measurement server. install.sh writes deploy/.env from these
# values; to change them later, edit deploy/.env and run install.sh again.

# Public name of this server. Caddy gets a certificate for it, so point an A record
# (and an AAAA record if the host has IPv6) at the server before the first start.
DOMAIN=fra-01.example.org

# Shown in the app.
SERVER_NAME=fra-01
SERVER_LOCATION=NUREMBERG, DE

# UDP port for the packet-loss test. Open it in the provider's firewall too.
RTC_PORT=40000

# On hosts whose network interface only has a private address behind 1:1 NAT (Oracle
# Cloud, AWS), the server must learn its public address to advertise it:
# STUN_URL=stun:stun.l.google.com:19302

# Per-client limits (see the main README). Defaults shown.
# CLIENT_HOURLY_GB=8
# CLIENT_MAX_STREAMS=8
# MAX_ACTIVE_CLIENTS=3
# CLIENT_MAX_LOSS_SESSIONS=2
